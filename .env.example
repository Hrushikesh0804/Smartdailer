# Copy to .env and fill in your values.
# The psycopg v3 driver requires the postgresql+psycopg:// URL scheme.

DB_URL=postgresql+psycopg://smartdialer:smartdialer@localhost:5432/smartdialer
TEST_DB_URL=postgresql+psycopg://smartdialer:smartdialer@localhost:5432/smartdialer_test

# --- Agent reservation ---
# How long an agent stays RESERVED before the recovery sweeper reclaims it (seconds)
AGENT_RESERVATION_TTL_SECONDS=30

# --- Call lease ---
# How long a call row can sit in a non-terminal state before the sweeper intervenes (seconds)
CALL_LEASE_TTL_SECONDS=120

# --- Allocator ---
# Max calls to allocate per campaign per pacing tick
MAX_ALLOCATIONS_PER_TICK=10

# --- Pacing (placeholders for Phase 2) ---
# Smoothing prior: pseudo-observations added to answer-rate Beta prior
BETA_PRIOR_ALPHA=1.0
BETA_PRIOR_BETA=1.0
# Safety: max concurrent calls multiplier over available agents
MAX_LINES_PER_AGENT=3.0
